{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth UID" },
        "fullName": { "type": "string", "maxLength": 100, "description": "User full name" },
        "email": { "type": "string", "maxLength": 150, "description": "User college email" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "Access role" },
        "studentId": { "type": "string", "maxLength": 30, "description": "Campus student or staff ID" },
        "department": { "type": "string", "maxLength": 100, "description": "College department" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "fullName", "email", "role"]
    },
    "Item": {
      "title": "Item",
      "description": "Lost or found item report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique report ID" },
        "ownerId": { "type": "string", "description": "UID of the user who submitted the report" },
        "ownerName": { "type": "string", "maxLength": 100, "description": "Reporter name" },
        "ownerEmail": { "type": "string", "maxLength": 150, "description": "Reporter email" },
        "reportType": { "type": "string", "enum": ["lost", "found"], "description": "Lost or Found type" },
        "itemName": { "type": "string", "maxLength": 120, "description": "Name or title of item" },
        "normalizedName": { "type": "string", "maxLength": 120, "description": "Lowercase searchable name" },
        "category": { "type": "string", "enum": ["Electronics", "Books and Stationery", "Bags", "ID Cards", "Clothing", "Keys", "Water Bottles", "Accessories", "Other"], "description": "Category" },
        "description": { "type": "string", "maxLength": 1500, "description": "Detailed description" },
        "keywords": { "type": "string", "description": "Normalized searchable keywords" },
        "location": { "type": "string", "maxLength": 150, "description": "Campus location" },
        "eventDate": { "type": "string", "maxLength": 20, "description": "Date lost or found" },
        "imageUrl": { "type": "string", "maxLength": 500000, "description": "Item photo data or URL" },
        "distinguishingFeatures": { "type": "string", "maxLength": 500, "description": "Distinguishing marks" },
        "contactPreference": { "type": "string", "enum": ["email", "in_app", "phone"], "description": "Preferred contact mode" },
        "contactPhone": { "type": "string", "maxLength": 30, "description": "Optional phone number" },
        "status": { "type": "string", "enum": ["Pending Review", "Active", "Matched", "Claim Pending", "Returned / Resolved", "Rejected", "Closed"], "description": "Report lifecycle status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "ownerId", "ownerName", "reportType", "itemName", "category", "description", "location", "eventDate", "status"]
    },
    "Claim": {
      "title": "Claim",
      "description": "Claim request submitted against an item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Claim ID" },
        "itemId": { "type": "string", "description": "Associated item document ID" },
        "itemTitle": { "type": "string", "maxLength": 120, "description": "Item title" },
        "reportType": { "type": "string", "enum": ["lost", "found"], "description": "Item report type" },
        "ownerId": { "type": "string", "description": "Item reporter UID" },
        "claimantId": { "type": "string", "description": "Claimant UID" },
        "claimantName": { "type": "string", "maxLength": 100, "description": "Claimant name" },
        "claimantEmail": { "type": "string", "maxLength": 150, "description": "Claimant email" },
        "explanation": { "type": "string", "maxLength": 2000, "description": "Detailed explanation of ownership" },
        "identifyingDetails": { "type": "string", "maxLength": 1000, "description": "Private proof or distinguishing details" },
        "supportingInfo": { "type": "string", "maxLength": 500, "description": "Additional supporting info" },
        "status": { "type": "string", "enum": ["Pending", "Under Review", "Approved", "Rejected", "Completed"], "description": "Claim status" },
        "reviewedBy": { "type": "string", "maxLength": 128, "description": "UID of reviewer or admin" },
        "adminNotes": { "type": "string", "maxLength": 500, "description": "Notes from reviewer" },
        "createdAt": { "type": "string", "description": "Submission timestamp" },
        "updatedAt": { "type": "string", "description": "Review or update timestamp" }
      },
      "required": ["id", "itemId", "itemTitle", "ownerId", "claimantId", "claimantName", "explanation", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "userId": { "type": "string", "description": "Target recipient UID" },
        "title": { "type": "string", "maxLength": 150, "description": "Notification title" },
        "message": { "type": "string", "maxLength": 500, "description": "Notification body" },
        "type": { "type": "string", "enum": ["match", "claim_created", "claim_approved", "claim_rejected", "status_change", "item_resolved", "system"], "description": "Notification category" },
        "itemId": { "type": "string", "maxLength": 128, "description": "Related item ID" },
        "claimId": { "type": "string", "maxLength": 128, "description": "Related claim ID" },
        "read": { "type": "boolean", "description": "Read status" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["id", "userId", "title", "message", "type", "read"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions and verification audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Audit entry ID" },
        "actorId": { "type": "string", "description": "Administrator UID" },
        "actorEmail": { "type": "string", "maxLength": 150, "description": "Administrator email" },
        "action": { "type": "string", "maxLength": 100, "description": "Action executed" },
        "targetType": { "type": "string", "enum": ["item", "claim", "user", "system"], "description": "Target resource type" },
        "targetId": { "type": "string", "maxLength": 128, "description": "Target resource ID" },
        "details": { "type": "string", "maxLength": 1000, "description": "Action summary" },
        "createdAt": { "type": "string", "description": "Timestamp" }
      },
      "required": ["id", "actorId", "actorEmail", "action", "targetType", "targetId", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Registered admins fast-lookup"
    },
    "/items/{itemId}": {
      "schema": { "$ref": "#/entities/Item" },
      "description": "Lost and Found item listings"
    },
    "/claims/{claimId}": {
      "schema": { "$ref": "#/entities/Claim" },
      "description": "Ownership claims filed by claimants"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Targeted notifications"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Administrative audit trail"
    }
  }
}
